<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.Peter.mapper.CommentMapper">
    <resultMap id="CommentResultMap" type="com.Peter.entity.CommentEntity">
        <id property="id"  column="id"/>  <!--主键-->
        <result property="userId"  column="user_id"/>
        <result property="module"  column="module"/>
        <result property="resourceId"  column="resource_id"/>
        <result property="content"  column="content"/>
        <result property="status"  column="status"/>
        <result property="score"  column="score"/>
        <result property="likeNum"  column="like_num"/>
        <result property="isDelete"  column="is_delete"/>
        <result property="createTime"  column="create_time"/>
        <result property="updateTime"  column="update_time"/>
    </resultMap>

   <insert id="addComment" parameterType="com.Peter.entity.CommentEntity">
       insert into comment(
         module,
         user_id,
         resource_id,
         content,
         status,
         score,
         like_num,
         is_delete,
         create_time,
         update_time
         )
       values(
     #{module},
     #{userId},
     #{resourceId},
     #{content},
     #{status},
     #{score},
     #{likeNum},
     #{isDelete},
     #{createTime},
     #{updateTime}
       )
   </insert>

    <delete id="deleteCommentById" parameterType="java.lang.Long">
      delete from comment where id=#{id}
    </delete>
    <update id="updateCommentById" parameterType="com.Peter.entity.CommentParam">
     update comment set is_delete=#{isDelete}
      update comment set is_delete=#{isDelete},update_time=#{updateTime}
        <where>
           <if test="module != null">
                and module= #{module}
            </if>
            <if test="resourceId != null">
                and resource_id= #{resourceId}
            </if>
            <if test="userId!= null">
                and user_id= #{userId}
            </if>
            <if test="id!=null">
                and id= #{id}
            </if>
        </where>
    </update>

    <select id="queryCommentByParam" resultMap="CommentResultMap" parameterType="com.Peter.entity.CommentParam">
       select * from comment
        <where>
            <if test="module != null">
                and module=#{module}
            </if>
            <if test="isDelete!=null">
                and is_delete= #{isDelete}
            </if>
            <if test="resourceId != null">
                and resource_id=#{resourceId}
            </if>
            <if test="score != null">
                and score=#{score}
            </if>
        </where>
        <if test="orderBy!= null and orderBy!='' ">
            order by ${orderBy}
            <if test="orderDirection!=null and orderDirection!='' "> --不是空字符串
                ${orderDirection}
            </if>--按照排列方式逆序或顺序排列
        </if>
   </select>

    <select id="countCommentCountByParam" resultType="java.lang.Integer"  parameterType="com.Peter.entity.CommentParam">
       select count(*) from comment
       <where>
           <if test="isDelete!=null">
               and is_delete= #{isDelete}
           </if>
          <if test="module != null">
              and module=#{module}
          </if>
          <if test="resourceId != null">
               and resource_id=#{resourceId}
          </if>
           <if test="score != null">
               and score=#{score}
           </if>

       </where>
   </select>
</mapper>